{
    "name": "Typhon Dev Container",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "postCreateCommand": "uv sync && cd mncore_judge && uv pip install -r ./judge-py/requirements.txt",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-python-envs",
                "detachhead.basedpyright",
                "charliermarsh.ruff",
                "gruntfuggly.todo-tree",
                "eamodio.gitlens",
                "oderwat.indent-rainbow",
            ],
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
                "chat.tools.autoApprove": true,
                "chat.tools.edits.autoApprove": true,
                "chat.tools.terminal.autoApprove": true,
                "chat.agent.maxRequests": 100,
                "python.languageServer": "None", // None to use basedpyright
                "python.autoComplete.extraPaths": [
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/.venv/Lib/site-packages"
                ],
                "basedpyright.analysis.diagnosticMode": "workspace",
                "basedpyright.disableLanguageServices": false,
                "basedpyright.analysis.logLevel": "Trace"
            }
        }
    }
}
